# Frontend defaults for `vite` / `vite --mode development`.
# Loaded automatically by Vite. Override locally with .env.development.local
# (gitignored). Values are baked into the bundle at build/serve time.

# Emotion-detection demo: off by default. Set to "true" locally when running
# the backend so the demo on /mit-data-science is interactive.
VITE_ENABLE_EMOTION_DEMO=true
