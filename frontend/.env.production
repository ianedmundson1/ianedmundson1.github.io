# Frontend defaults for `vite build` (production).
# Loaded automatically by Vite. Used for both the GitHub Pages deploy and the
# Docker fullstack image build. The fullstack Dockerfile sets
# VITE_ENABLE_EMOTION_DEMO=true at build time to override this default, since
# the backend is present in that image.

# Off by default so the Pages deploy (no backend) cannot accidentally call /api.
VITE_ENABLE_EMOTION_DEMO=false
