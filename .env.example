# ── Databricks ────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your-databricks-token

# ── Sentry (hosted — free tier at https://sentry.io) ─────────────────────────
# Create a project at sentry.io and paste the DSN here.
# Both vars should have the same value — SENTRY_DSN is used by the FastAPI
# backend at runtime; VITE_SENTRY_DSN is baked into the React bundle at build
# time (requires image rebuild after changing).
SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project-id>
VITE_SENTRY_DSN=https://<key>@o0.ingest.sentry.io/<project-id>
