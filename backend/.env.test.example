# Backend defaults for APP_ENV=test (pytest, CI).
# Copy to backend/.env.test. Tests should not call the real Databricks endpoint,
# mock or stub the WorkspaceClient instead.

DATABRICKS_HOST=https://test.invalid
DATABRICKS_TOKEN=test-token

# Sentry off in tests so failing tests do not page anyone.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

#email for contact form
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_SERVER=
MAIL_PORT=