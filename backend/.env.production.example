# Backend defaults for APP_ENV=production (Docker fullstack runtime).
# Copy to backend/.env.production and fill in real values. In a real deploy,
# prefer setting these as container/host env vars rather than baking them into
# a file shipped with the image.

DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your-databricks-token

# Analytics datasource configuration. See backend/datasource/__init__.py.
DATA_SOURCE=databricks
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your-warehouse-id
SEATTLE_FIRE_911_TABLE=seattle_data.seattle_bronze.seattle_fire_911_calls

# Sentry. Bump sample rates here to ship traces from prod.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0

#email for contact form
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_SERVER=
MAIL_PORT=