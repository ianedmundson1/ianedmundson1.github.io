# Backend defaults for APP_ENV=development.
# Copy to backend/.env.development and fill in values. Loaded automatically by
# backend/main.py at startup. Values already in the process environment are
# NOT overridden, so shell/Docker exports always win.

# Databricks credentials for the emotion-detection demo. Without these the
# /api/emotion_classification endpoint returns 503 (see /api/ready check).
DATABRICKS_HOST=https://your-workspace.azuredatabricks.net
DATABRICKS_TOKEN=your-databricks-token

# Sentry. Leave blank to disable error reporting in local dev.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0

#email for contact form
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_TO=
MAIL_SERVER=
MAIL_PORT=